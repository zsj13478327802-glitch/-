# Required: 12+ chars. Set these in Railway > Service > Variables, NOT in GitHub.
ZX_ACCESS_PASSWORD=SET_A_LONG_UNIQUE_ACCESS_PASSWORD
OPENAI_API_KEY=SET_YOUR_OPENAI_API_KEY
# App config
ZX_CLOUD_MODE=1
ZX_DATA_DIR=/app/data
ZX_MAX_AI_IMAGES_PER_JOB=30
ZX_MAX_UPLOAD_MB=160
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_VISION_MODEL=gpt-4.1-mini
